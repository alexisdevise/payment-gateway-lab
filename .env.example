# Local secrets for docker compose, kind (launchK8s.cmd) and IDE runs (profile "local").
# Copy to .env (git-ignored) and adjust:   copy .env.example .env
# These are the public lab demo values; preprod / prod secrets come from a vault, never from this file.

# PostgreSQL
POSTGRES_DB=payment_db
POSTGRES_USER=payment_user
POSTGRES_PASSWORD=payment_pass

# AES-256-GCM key (base64, 32 bytes) for payload key id "dev-2026-11", shared with the consumer apps.
# Generate a new one:  openssl rand -base64 32
PAYMENT_CRYPTO_KEY_DEV=OR+gyWqOKMP+WybfmCTzFW1LYLAZ6u2d5zCW46iv4fI=

# SHA-256 (hex) of each consumer's API key. Only the hash is configured; the consumer keeps the key itself.
# Real keys must be long and random (an unsalted SHA-256 of a guessable key is brute-forced in seconds):
#   KEY=$(openssl rand -base64 32)   then   printf %s "$KEY" | sha256sum
# Demo keys (README / tests): dev-ecommerce-key-local, dev-merchant-bo-key-change-me, dev-other-merchant-key-change-me
API_KEY_SHA256_CHECKOUT_WEB=180571dc3b0a005f768df736f1f36be396b48b5827f9caf4bc8352f4efdec9c6
API_KEY_SHA256_MERCHANT_BACKOFFICE=f42484cc93a1f4e1fff048dbb7d6b1f0a8884901c4cd369a3d4a4123dc3c5799
API_KEY_SHA256_OTHER_MERCHANT_BACKOFFICE=937158f3e31cbaa45fab25a1a6d82b119eb8e17bd9c1ffdcea3d85e1692a43cd
